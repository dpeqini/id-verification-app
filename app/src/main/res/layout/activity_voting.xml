<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#CC0000"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/voterNameText"
            android:text="Welcome"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:strokeColor="#FFFFFF" />
    </LinearLayout>

    <!-- ══ LOADING ══ -->
    <LinearLayout
        android:id="@+id/loadingScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#CC0000" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading…"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ══ BALLOT SCREEN ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ballotScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Election header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/electionHeaderCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#FFF8F8"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#CC0000"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/electionNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CC0000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/electionTypeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/electionStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ballotSummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Selection summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionSummaryCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="8dp"
            app:strokeColor="#2E7D32"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/electionHeaderCard">

            <TextView
                android:id="@+id/selectionSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ballot list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ballotRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/selectionSummaryCard" />

        <!-- Cast Vote button pinned to bottom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/castVoteButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="12dp"
            android:enabled="false"
            android:text="Cast My Vote"
            android:textSize="16sp"
            app:backgroundTint="#CC0000"
            app:cornerRadius="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ ALREADY VOTED SCREEN ══ -->
    <ScrollView
        android:id="@+id/alreadyVotedScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="✓"
                android:textColor="#2E7D32"
                android:textSize="72sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="24dp"
                android:text="Your vote has been recorded"
                android:textColor="#2E7D32"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="ELECTION DETAILS"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/avElectionName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:textColor="#CC0000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/avElectionType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/avElectionDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/avTotalVotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/avTurnout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/avPartyCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Thank you for participating in democracy."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ══ RECEIPT SCREEN ══ -->
    <ScrollView
        android:id="@+id/receiptScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#2E7D32"
                android:textSize="72sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="Vote Cast Successfully"
                android:textColor="#2E7D32"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="24dp"
                android:text="Recorded on the blockchain"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#E8F5E9"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#A5D6A7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="16dp"
                        android:text="VOTE RECEIPT"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Election -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Election" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptElectionName" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="15sp"
                        android:textStyle="bold" android:paddingBottom="12dp"/>

                    <!-- Candidate -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Candidate" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptCandidateName" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="15sp"
                        android:textStyle="bold" android:paddingBottom="12dp"/>

                    <!-- Party -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Party" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptPartyName" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="15sp" android:paddingBottom="12dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#A5D6A7" android:layout_marginBottom="12dp"/>

                    <!-- Vote Hash -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Vote Hash" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptVoteHash" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="12sp"
                        android:fontFamily="monospace" android:paddingBottom="8dp"/>

                    <!-- Receipt Token -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Receipt Token" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptToken" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="12sp"
                        android:fontFamily="monospace" android:paddingBottom="8dp"/>

                    <!-- Blockchain -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Blockchain" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptBlockchain" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="12sp"
                        android:fontFamily="monospace" android:paddingBottom="8dp"/>

                    <!-- Timestamp -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Timestamp" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
                    <TextView android:id="@+id/receiptTimestamp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Save your receipt token to verify at voting.albania.gov"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ══ ERROR SCREEN ══ -->
    <LinearLayout
        android:id="@+id/errorScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="⚠"
            android:textColor="#CC0000"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Try Again"
            app:backgroundTint="#CC0000"
            app:cornerRadius="24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
