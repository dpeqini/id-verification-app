<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows cleartext (HTTP) traffic to 10.0.2.2 (emulator localhost) and
    192.168.x.x (physical device on local Wi-Fi) in debug builds only.

    Android 9+ blocks all cleartext traffic by default. Without this file,
    the request to http://10.0.2.2:8081/ is silently dropped by the OS before
    it even reaches OkHttp.

    Reference this in AndroidManifest.xml inside <application>:
        android:networkSecurityConfig="@xml/network_security_config"
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Production: full certificate pinning, no cleartext -->
    <!-- <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.voting.albania.gov</domain>
        <pin-set> -->
            <!-- Replace with your real SHA-256 pins before release -->
            <!-- <pin digest="SHA-256">REPLACE_WITH_YOUR_PRIMARY_SHA256_PIN=</pin>
            <pin digest="SHA-256">REPLACE_WITH_YOUR_BACKUP_SHA256_PIN=</pin>
        </pin-set>
    </domain-config> -->
    

    <!-- Development: allow HTTP to emulator host (10.0.2.2) and local LAN -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>       <!-- emulator → host localhost -->
        <domain includeSubdomains="true">192.168.0.0</domain>     <!-- LAN — adjust subnet if needed -->
        <domain includeSubdomains="true">192.168.1.89</domain>     <!-- LAN — adjust subnet if needed -->
        <domain includeSubdomains="true">192.168.100.58</domain>     <!-- LAN — adjust subnet if needed -->
        <domain includeSubdomains="true">10.0.0.0</domain>        <!-- LAN fallback -->
    </domain-config>

</network-security-config>
