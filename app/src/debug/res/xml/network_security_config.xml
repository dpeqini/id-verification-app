<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY network security config.

    Overrides src/main/res/xml/network_security_config.xml for debug builds only.
    Permits cleartext (HTTP) to ANY host so the app can reach the backend on any
    local network — the emulator host (10.0.2.2) or any physical-device Wi-Fi IP
    (e.g. 192.168.1.132) — without having to whitelist each IP by hand.

    Release builds keep the strict config in src/main (HTTPS + certificate pinning,
    no cleartext), so this loosening never ships to production.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
